# Neon connection string (Neon dashboard -> Connection Details -> "Pooled connection" recommended)
DATABASE_URL=postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Long random string -- signs session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=

# CORS: the console's origin(s), comma-separated. No trailing slashes.
CONSOLE_ORIGIN=http://localhost:3000

PORT=8080

# Stripe (see README.md -- all optional until you enable billing; signup/
# trial works without them, checkout/portal routes will 500 without them)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:3000
